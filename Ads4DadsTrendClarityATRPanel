        #region Swing module
        private double ComputeSwingScore()
        {
            swingLabel = "Neutral";
            if (swingFast == null) return 0.0;

            int hiAgo = swingFast.SwingHighBar(0, 1, CurrentBar);
            int loAgo = swingFast.SwingLowBar(0, 1, CurrentBar);

            double lastHigh = (hiAgo >= 0 && hiAgo <= CurrentBar) ? High[hiAgo] : double.NaN;
            double lastLow  = (loAgo >= 0 && loAgo <= CurrentBar) ? Low[loAgo]  : double.NaN;

            if (double.IsNaN(lastHigh) && double.IsNaN(lastLow)) return 0.0;

            double buf = SwingBufferTicks * TickSize;
            bool bullBreak = !double.IsNaN(lastHigh) && Close[0] > lastHigh + buf;
            bool bearBreak = !double.IsNaN(lastLow)  && Close[0] < lastLow  - buf;

            if (SwingConfirmBars > 0)
            {
                if (bullBreak)
                {
                    bool ok = true;
                    for (int i = 0; i < SwingConfirmBars; i++) ok = ok && Close[i] > lastHigh + buf;
                    bullBreak = ok;
                }
                if (bearBreak)
                {
                    bool ok = true;
                    for (int i = 0; i < SwingConfirmBars; i++) ok = ok && Close[i] < lastLow - buf;
                    bearBreak = ok;
                }
            }

            double slopeFast = SafeDelta(emaFast, 1);
            if (bullBreak && slopeFast < 0) bullBreak = false;
            if (bearBreak && slopeFast > 0) bearBreak = false;

            if (swingCooldownLeft > 0) swingCooldownLeft--;

            double score = 0.0;
            if (bullBreak && (swingCooldownLeft == 0 || (CurrentBar - lastBreakoutBar) >= SwingCooldownBars))
            {
                score = +1.0; swingLabel = "Bullish";
                swingCooldownLeft = SwingCooldownBars; lastBreakoutBar = CurrentBar;
            }
            else if (bearBreak && (swingCooldownLeft == 0 || (CurrentBar - lastBreakoutBar) >= SwingCooldownBars))
            {
                score = -1.0; swingLabel = "Bearish";
                swingCooldownLeft = SwingCooldownBars; lastBreakoutBar = CurrentBar;
            }
            else
            {
                int hiAgoCtx = swingCtx.SwingHighBar(0, 1, CurrentBar);
                int loAgoCtx = swingCtx.SwingLowBar(0, 1, CurrentBar);
                if (hiAgoCtx >= 0 && loAgoCtx >= 0 && emaSlow != null)
                {
                    bool aboveSlow = Close[0] > emaSlow[0];
                    bool belowSlow = Close[0] < emaSlow[0];
                    if (loAgoCtx < hiAgoCtx && aboveSlow) { score = Math.Max(score, +0.25); swingLabel = "Bullish"; }
                    else if (hiAgoCtx < loAgoCtx && belowSlow) { score = Math.Min(score, -0.25); swingLabel = "Bearish"; }
                    else swingLabel = "Neutral";
                }
            }

            return score;
        }
