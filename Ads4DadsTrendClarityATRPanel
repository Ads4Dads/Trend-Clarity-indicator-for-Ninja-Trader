        private int ComputeNearestSRTicks()
        {
            int nearest = int.MaxValue;

            if (nearestAboveTicks != int.MaxValue)
                nearest = Math.Min(nearest, nearestAboveTicks);

            if (nearestBelowTicks != int.MaxValue)
                nearest = Math.Min(nearest, nearestBelowTicks);

            return nearest;
        }

        private void UpdateNearestSR()
        {
            double price = Close[0];

            var c = new System.Collections.Generic.List<SRLevel>();
            if (!double.IsNaN(priorDayHigh))   c.Add(new SRLevel("Prior Day High", priorDayHigh));
            if (!double.IsNaN(priorDayLow))    c.Add(new SRLevel("Prior Day Low",  priorDayLow));
            if (!double.IsNaN(priorWeekHigh))  c.Add(new SRLevel("Prior Week High", priorWeekHigh));
            if (!double.IsNaN(priorWeekLow))   c.Add(new SRLevel("Prior Week Low",  priorWeekLow));
            if (!double.IsNaN(currentDayHigh)) c.Add(new SRLevel("Current Day High (Developing)", currentDayHigh));
            if (!double.IsNaN(currentDayLow))  c.Add(new SRLevel("Current Day Low (Developing)",  currentDayLow));

            double nearestAboveDist = double.PositiveInfinity; string nearestAboveName = null;
            double nearestBelowDist = double.PositiveInfinity; string nearestBelowName = null;

            for (int i = 0; i < c.Count; i++)
            {
                double diff = c[i].Level - price;
                if (diff > 0 && diff < nearestAboveDist) { nearestAboveDist = diff; nearestAboveName = c[i].Name; }
                if (diff < 0 && -diff < nearestBelowDist){ nearestBelowDist = -diff; nearestBelowName = c[i].Name; }
            }

            nearestAboveTicks = (nearestAboveName == null) ? int.MaxValue
                : (int)Math.Round(nearestAboveDist / TickSize, MidpointRounding.AwayFromZero);
            nearestBelowTicks = (nearestBelowName == null) ? int.MaxValue
                : (int)Math.Round(nearestBelowDist / TickSize, MidpointRounding.AwayFromZero);

            // Persist names for display
            this.nearestAboveName = nearestAboveName;
            this.nearestBelowName = nearestBelowName;

            // Prebuild readable SR distance lines (anchor-based)
            srAboveText = (nearestAboveName == null) ? "Nearest Above: none"
                : ("Nearest Above: " + nearestAboveName + " (" + nearestAboveTicks + "t)");
            srBelowText = (nearestBelowName == null) ? "Nearest Below: none"
                : ("Nearest Below: " + nearestBelowName + " (" + nearestBelowTicks + "t)");


            // Nearest S/R distance in ticks (min of above/below). Used for SR proximity penalty.
            nearestSRTicks = ComputeNearestSRTicks();
        }

        private void BuildDisplayStrings()
        {
            lineBadge = headlineState + " " + (headlineState == "SELL" ? (100 - headlineProb) : headlineProb) + "%";
            lineShort = "Short-term Trend: " + shortState + " " + (shortState == "SELL" ? (100 - shortProb) : shortProb) + "%";
            lineLong  = "Long-term Trend: " + longState  + " " + (longState  == "SELL" ? (100 - longProb)  : longProb)  + "%";
            lineNet   = ShowNetChangePercent
                ? ("Net Change: " + (netChangePct >= 0 ? "+" : "") + Math.Round(netChangePct, 2, MidpointRounding.AwayFromZero).ToString("0.00") + "%")
                : "";
            lineSwing   = ShowSwingLine  ? ("Swing: " + swingLabel) : "";
            lineSignal  = ShowSignalLine ? ("Signal: " + signal) : "";

            // Anchor-based SR distances (optional)
            lineSR = "";
            if (ShowSRDistances)
            {
                // If a directional signal exists, show the nearest barrier in that direction
                if (string.Equals(signal, "BUY", StringComparison.OrdinalIgnoreCase))
                {
                    lineSR = (nearestAboveName == null) ? "SR: none above" : ("SR: " + nearestAboveName + " in " + nearestAboveTicks + "t");
                }
                else if (string.Equals(signal, "SELL", StringComparison.OrdinalIgnoreCase))
                {
                    lineSR = (nearestBelowName == null) ? "SR: none below" : ("SR: " + nearestBelowName + " in " + nearestBelowTicks + "t");
                }
                else
                {
                    lineSR = srAboveText + " | " + srBelowText;
                }
            }

            // Open space hint (optional, anchor-based). Uses the nearest barrier in the signal direction.
            lineSpace = "";
            openSpaceOkDirection = true;
            openSpaceTicksDirection = int.MaxValue;

            if (ShowOpenSpaceHint)
            {
                if (string.Equals(signal, "BUY", StringComparison.OrdinalIgnoreCase))
                {
                    openSpaceTicksDirection = nearestAboveTicks;
                }
                else if (string.Equals(signal, "SELL", StringComparison.OrdinalIgnoreCase))
                {
                    openSpaceTicksDirection = nearestBelowTicks;
                }
                else
                {
                    // No directional signal -> no open-space assessment
                    openSpaceTicksDirection = int.MaxValue;
                }

                if (openSpaceTicksDirection == int.MaxValue)
                {
                    lineSpace = "Open Space: n/a";
                    openSpaceOkDirection = true;
                }
                else
                {
                    openSpaceOkDirection = (openSpaceTicksDirection >= OpenSpaceThresholdTicks);
                    lineSpace = "Open Space: " + (openSpaceOkDirection ? "YES" : "NO") + " (" + openSpaceTicksDirection + "t)";
                }
            }
        }

