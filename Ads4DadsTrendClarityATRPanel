        #region Swing module
        private double ComputeSwingScore()
        {
            swingLabel = "Neutral";
            if (swingFast == null) return 0.0;

            int hiAgo = swingFast.SwingHighBar(0, 1, CurrentBar);
            int loAgo = swingFast.SwingLowBar(0, 1, CurrentBar);

            double lastHigh = (hiAgo >= 0 && hiAgo <= CurrentBar) ? High[hiAgo] : double.NaN;
            double lastLow  = (loAgo >= 0 && loAgo <= CurrentBar) ? Low[loAgo]  : double.NaN;

            if (double.IsNaN(lastHigh) && double.IsNaN(lastLow)) return 0.0;

            double buf = SwingBufferTicks * TickSize;
            bool bullBreak = !double.IsNaN(lastHigh) && Close[0] > lastHigh + buf;
            bool bearBreak = !double.IsNaN(lastLow)  && Close[0] < lastLow  - buf;

            if (SwingConfirmBars > 0)
            {
                if (bullBreak)
                {
                    bool ok = true;
                    for (int i = 0; i < SwingConfirmBars; i++) ok = ok && Close[i] > lastHigh + buf;
                    bullBreak = ok;
                }
                if (bearBreak)
                {
                    bool ok = true;
                    for (int i = 0; i < SwingConfirmBars; i++) ok = ok && Close[i] < lastLow - buf;
                    bearBreak = ok;
                }
            }

            double slopeFast = SafeDelta(emaFast, 1);
            if (bullBreak && slopeFast < 0) bullBreak = false;
            if (bearBreak && slopeFast > 0) bearBreak = false;

            if (swingCooldownLeft > 0) swingCooldownLeft--;

            double score = 0.0;
            if (bullBreak && (swingCooldownLeft == 0 || (CurrentBar - lastBreakoutBar) >= SwingCooldownBars))
            {
                score = +1.0; swingLabel = "Bullish";
                swingCooldownLeft = SwingCooldownBars; lastBreakoutBar = CurrentBar;
            }
            else if (bearBreak && (swingCooldownLeft == 0 || (CurrentBar - lastBreakoutBar) >= SwingCooldownBars))
            {
                score = -1.0; swingLabel = "Bearish";
                swingCooldownLeft = SwingCooldownBars; lastBreakoutBar = CurrentBar;
            }
            else
            {
                int hiAgoCtx = swingCtx.SwingHighBar(0, 1, CurrentBar);
                int loAgoCtx = swingCtx.SwingLowBar(0, 1, CurrentBar);
                if (hiAgoCtx >= 0 && loAgoCtx >= 0 && emaSlow != null)
                {
                    bool aboveSlow = Close[0] > emaSlow[0];
                    bool belowSlow = Close[0] < emaSlow[0];
                    if (loAgoCtx < hiAgoCtx && aboveSlow) { score = Math.Max(score, +0.25); swingLabel = "Bullish"; }
                    else if (hiAgoCtx < loAgoCtx && belowSlow) { score = Math.Min(score, -0.25); swingLabel = "Bearish"; }
                    else swingLabel = "Neutral";
                }
            }

            return score;
        }
        #endregion

        #region Model math
        private void ComputeProbabilitiesModel(double swingScore)
        {
            double wSlope = WtSlope, wAtr = WtAtr, wSR = WtSR, wVix = WtVix, wNet = WtNet, wPos = WtPos, wMom = WtMom, wSwing = WtSwing;
            double wSum = Math.Max(1.0, wSlope + wAtr + wSR + wVix + wNet + wPos + wMom + wSwing);
            wSlope/=wSum; wAtr/=wSum; wSR/=wSum; wVix/=wSum; wNet/=wSum; wPos/=wSum; wMom/=wSum; wSwing/=wSum;

            double slopeFast = SafeDelta(emaFast, 1) / Math.Max(1e-12, emaFast[0]);
            double slopeSlow = SafeDelta(emaSlow, 1) / Math.Max(1e-12, emaSlow[0]);
            double nSlopeFast = Math.Tanh(slopeFast * 250.0);
            double nSlopeSlow = Math.Tanh(slopeSlow * 250.0);

            double atrExpFast = SafeDelta(atrFast, 1) / Math.Max(1e-12, atrFast[1]);
            double atrExpSlow = SafeDelta(atrSlow, 1) / Math.Max(1e-12, atrSlow[1]);
            double nAtrFast = Math.Tanh(Math.Abs(atrExpFast) * 10.0) * Math.Sign(nSlopeFast);
            double nAtrSlow = Math.Tanh(Math.Abs(atrExpSlow) * 10.0) * Math.Sign(nSlopeSlow);

            double srRoom;
            if (nearestAboveTicks == int.MaxValue && nearestBelowTicks == int.MaxValue) srRoom = 0.0;
            else if (nearestAboveTicks == int.MaxValue) srRoom = 1.0;
            else if (nearestBelowTicks == int.MaxValue) srRoom = -1.0;
            else
            {
                double num = (double)nearestBelowTicks - (double)nearestAboveTicks;
                double den = (double)nearestBelowTicks + (double)nearestAboveTicks;
                srRoom = Math.Tanh((num / Math.Max(1.0, den)) * 2.0);
            }

            double vixScore = 0.0;
            if (vixRegime == "Calm") vixScore = +0.25;
            else if (vixRegime == "High Volatility") vixScore = -0.25;

            double nNet = Math.Tanh(netChangePct / 0.8);

            double pos = 0.0;
            if (atrSlow != null && atrSlow[0] > 0)
            {
                double z = (Close[0] - emaSlow[0]) / (2.0 * atrSlow[0]);
                pos = Math.Tanh(z);
            }

            double mom = 0.0;
            int n = Math.Max(1, MomLookback);
            if (CurrentBar >= n && atrFast != null && atrFast[0] > 0)
            {
                double dz = (Close[0] - Close[n]) / (2.0 * atrFast[0]);
                mom = Math.Tanh(dz);
            }

            double breakoutBias = 0.0;
            if (!double.IsNaN(priorDayLow)  && Close[0] < priorDayLow)  breakoutBias -= 0.20;
            if (!double.IsNaN(priorWeekLow) && Close[0] < priorWeekLow) breakoutBias -= 0.20;
            if (!double.IsNaN(priorDayHigh) && Close[0] > priorDayHigh)  breakoutBias += 0.20;
            if (!double.IsNaN(priorWeekHigh)&& Close[0] > priorWeekHigh)breakoutBias += 0.20;

            double nSwing = Math.Tanh(swingScore);

            double shortScore =
                (wSlope * 1.20) * nSlopeFast +
                (wAtr   * 1.00) * nAtrFast  +
                (wMom   * 1.20) * mom       +
                (wSR    * 1.00) * srRoom    +
                (wVix   * 1.00) * vixScore  +
                (wNet   * 0.80) * nNet      +
                (wPos   * 0.50) * pos       +
                (wSwing * 1.00) * nSwing    +
                breakoutBias;

            double longScore  =
                (wSlope * 1.00) * nSlopeSlow +
                (wAtr   * 1.00) * nAtrSlow   +
                (wMom   * 0.60) * mom        +
                (wSR    * 1.00) * srRoom     +
                (wVix   * 1.00) * vixScore   +
                (wNet   * 0.60) * nNet       +
                (wPos   * 1.40) * pos        +
                (wSwing * 0.80) * nSwing     +
                breakoutBias;

            shortProb = ToPercent(shortScore);
            longProb  = ToPercent(longScore);

            shortState = ProbToState(shortProb);
            longState  = ProbToState(longProb);

            headlineProb  = (shortProb + longProb) / 2;
            headlineState = "CHOP";
            if (shortState == "BUY"  && longState == "BUY")   headlineState = "BUY";
            else if (shortState == "SELL" && longState == "SELL") headlineState = "SELL";
            else if (headlineProb >= 50 && headlineProb <= 59)    headlineState = "CAUTION";
        }

        private static int ToPercent(double score)
        {
            int p = (int)Math.Round(50.0 + 50.0 * Math.Tanh(score));
            if (p < 5) p = 5; if (p > 95) p = 95;
            return p;
        }
        private static string ProbToState(int p)
        {
            if (p >= 60) return "BUY";
            if (p <= 40) return "SELL";
            return "NEUTRAL";
        }
        private static double SafeDelta(NinjaTrader.NinjaScript.Indicators.EMA ema, int barsAgo)
        {
            if (ema == null || ema.CurrentBar < barsAgo) return 0.0;
            return ema[0] - ema[barsAgo];
        }
        private static double SafeDelta(NinjaTrader.NinjaScript.Indicators.ATR atr, int barsAgo)
        {
            if (atr == null || atr.CurrentBar < barsAgo) return 0.0;
            return atr[0] - atr[barsAgo];
        }
