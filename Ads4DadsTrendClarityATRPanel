        #region Badge streaks & Signal
        private void UpdateBadgeStreaks()
        {
            if (headlineState == "BUY" && headlineProb >= 60) { buyBadgeStreak++; sellBadgeStreak = 0; }
            else if (headlineState == "SELL" && headlineProb >= 60) { sellBadgeStreak++; buyBadgeStreak = 0; }
            else { buyBadgeStreak = 0; sellBadgeStreak = 0; }
        }

        private string signal = "WAIT";

        private void ComputeSignal()
        {
            bool priceAboveEMA = (emaSlow != null && Close[0] > emaSlow[0]);
            bool priceBelowEMA = (emaSlow != null && Close[0] < emaSlow[0]);

            bool swingBull = swingLabel == "Bullish";
            bool swingBear = swingLabel == "Bearish";

            bool longVeto  = (longProb >= 60 && longState == "BUY");
            bool shortVeto = (longProb <= 40 && longState == "SELL");

            // Primary triggers
            bool buyReady  = (headlineState == "BUY"  && headlineProb >= 60 && buyBadgeStreak >= 2 && shortProb >= 60 && swingBull && priceAboveEMA && !shortVeto);
            bool sellReady = (headlineState == "SELL" && headlineProb >= 60 && sellBadgeStreak >= 2 && shortProb <= 40 && swingBear && priceBelowEMA && !longVeto);

            // Early entry (optional)
            bool buyEarly = false, sellEarly = false;
            if (EnableEarlyEntry)
            {
                bool crossUp   = (emaSlow != null && Close[0] > emaSlow[0] && Close[1] <= emaSlow[1]);
                bool crossDown = (emaSlow != null && Close[0] < emaSlow[0] && Close[1] >= emaSlow[1]);

                buyEarly  = (headlineProb >= 55 && headlineProb < 60 && shortProb >= 60 && swingBull && crossUp && !shortVeto);
                sellEarly = (headlineProb >= 55 && headlineProb < 60 && shortProb <= 40 && swingBear && crossDown && !longVeto);
            }

            if (buyReady || buyEarly) signal = "BUY";
            else if (sellReady || sellEarly) signal = "SELL";
            else signal = "WAIT";
        }
        #endregion

        #region S/R + strings + CSV
        private void UpdateNearestSR()
        {
            double price = Close[0];

            var c = new System.Collections.Generic.List<SRLevel>();
            if (!double.IsNaN(priorDayHigh))   c.Add(new SRLevel("Prior Day High", priorDayHigh));
            if (!double.IsNaN(priorDayLow))    c.Add(new SRLevel("Prior Day Low",  priorDayLow));
            if (!double.IsNaN(priorWeekHigh))  c.Add(new SRLevel("Prior Week High", priorWeekHigh));
            if (!double.IsNaN(priorWeekLow))   c.Add(new SRLevel("Prior Week Low",  priorWeekLow));
            if (!double.IsNaN(currentDayHigh)) c.Add(new SRLevel("Current Day High (Developing)", currentDayHigh));
            if (!double.IsNaN(currentDayLow))  c.Add(new SRLevel("Current Day Low (Developing)",  currentDayLow));

            double nearestAboveDist = double.PositiveInfinity; string nearestAboveName = null;
            double nearestBelowDist = double.PositiveInfinity; string nearestBelowName = null;

            bool pdLowBreached  = !double.IsNaN(priorDayLow)  && price < priorDayLow;
            bool pwLowBreached  = !double.IsNaN(priorWeekLow) && price < priorWeekLow;
            bool pdHighBreached = !double.IsNaN(priorDayHigh) && price > priorDayHigh;
            bool pwHighBreached = !double.IsNaN(priorWeekHigh)&& price > priorWeekHigh;

            for (int i = 0; i < c.Count; i++)
            {
                double diff = c[i].Level - price;
                if (diff > 0 && diff < nearestAboveDist) { nearestAboveDist = diff; nearestAboveName = c[i].Name; }
                if (diff < 0 && -diff < nearestBelowDist){ nearestBelowDist = -diff; nearestBelowName = c[i].Name; }
            }

            nearestAboveTicks = (nearestAboveName == null) ? int.MaxValue
                : (int)Math.Round(nearestAboveDist / TickSize, MidpointRounding.AwayFromZero);
            nearestBelowTicks = (nearestBelowName == null) ? int.MaxValue
                : (int)Math.Round(nearestBelowDist / TickSize, MidpointRounding.AwayFromZero);
        }

        private void BuildDisplayStrings()
        {
            lineBadge = headlineState + " " + headlineProb + "%";
            lineShort = "Short-term Trend: " + shortState + " " + shortProb + "%";
            lineLong  = "Long-term Trend: " + longState  + " " + longProb  + "%";
            lineNet   = ShowNetChangePercent
                ? ("Net Change: " + (netChangePct >= 0 ? "+" : "") + Math.Round(netChangePct, 2, MidpointRounding.AwayFromZero).ToString("0.00") + "%")
                : "";
            lineSwing   = ShowSwingLine  ? ("Swing: " + swingLabel) : "";
            lineSignal  = ShowSignalLine ? ("Signal: " + signal) : "";
        }

        private void MaybeLogCsv()
        {
            if (lineBadge == lastLoggedBadge) return;
            lastLoggedBadge = lineBadge;

            try
            {
                bool writeHeader = !File.Exists(csvPath);
                using (var sw = new StreamWriter(csvPath, true, Encoding.UTF8))
                {
                    if (writeHeader)
                        sw.WriteLine("TimestampET,Instrument,BarType,NetBasisMode,NetChangePct,HeadlineState,HeadlineProb,ShortState,ShortProb,LongState,LongProb,NearestAboveTicks,NearestBelowTicks,VIXRegime,Signal");

                    string barType = BarsPeriod.BarsPeriodType + " " + BarsPeriod.Value;
                    string ts = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
                    string instrumentName = (Instrument != null) ? Instrument.FullName : "";

                    sw.WriteLine(string.Join(",",
                        ts,
                        instrumentName,
                        barType,
                        NetBasisMode,
                        Math.Round(netChangePct, 4, MidpointRounding.AwayFromZero).ToString(CultureInfo.InvariantCulture),
                        headlineState, headlineProb,
                        shortState, shortProb,
                        longState, longProb,
                        nearestAboveTicks, nearestBelowTicks,
                        vixRegime,
                        signal
                    ));
                }
            }
            catch { }
        }
        #endregion

        #region Rendering — overlay card
        protected override void OnRender(ChartControl chartControl, ChartScale chartScale)
        {
            base.OnRender(chartControl, chartScale);
            if (ChartControl == null || ChartPanel == null || RenderTarget == null) return;

            EnsureDxResources();

            float cardPadding = 10f;
            float lineGap = 4f;
            float width = Math.Max(OverlayWidth, 220);
            float x = ChartPanel.X + OverlayMargin;
            float bottom = ChartPanel.Y + ChartPanel.H - OverlayMargin;

            string vixLine = VIXRegimeLineEnabled ? ("VIX Regime: " + vixRegime) : "";

            using (var badgeLayout = new DW.TextLayout(dwFactory, lineBadge ?? "", tfBadge, width - cardPadding * 2, tfBadge.FontSize * 2.0f))
            using (var shLayout    = new DW.TextLayout(dwFactory, lineShort ?? "", tfLine,  width - 20f, tfLine.FontSize * 1.5f))
            using (var lgLayout    = new DW.TextLayout(dwFactory, lineLong  ?? "", tfLine,  width - 20f, tfLine.FontSize * 1.5f))
            using (var netLayout   = new DW.TextLayout(dwFactory, lineNet   ?? "", tfLine,  width - 20f, tfLine.FontSize * 1.5f))
            using (var swLayout    = new DW.TextLayout(dwFactory, lineSwing ?? "", tfLine,  width - 20f, tfLine.FontSize * 1.5f))
            using (var sigLayout   = new DW.TextLayout(dwFactory, lineSignal?? "", tfLine,  width - 20f, tfLine.FontSize * 1.5f))
            using (var vixLayout   = new DW.TextLayout(dwFactory, vixLine, tfLine, width - 20f, tfLine.FontSize * 1.5f))
            {
                float badgeH = tfBadge.FontSize * 1.8f + 6f;
                float h = cardPadding + badgeH + lineGap + 2f
                        + (float)Math.Ceiling(shLayout.Metrics.Height) + lineGap
                        + (float)Math.Ceiling(lgLayout.Metrics.Height);

                if (!string.IsNullOrEmpty(lineNet))     h += lineGap + (float)Math.Ceiling(netLayout.Metrics.Height);
                if (!string.IsNullOrEmpty(lineSwing))   h += lineGap + (float)Math.Ceiling(swLayout.Metrics.Height);
                if (!string.IsNullOrEmpty(lineSignal))  h += lineGap + (float)Math.Ceiling(sigLayout.Metrics.Height);
                if (!string.IsNullOrEmpty(vixLine))     h += lineGap + (float)Math.Ceiling(vixLayout.Metrics.Height);

                h += cardPadding;

                float top = bottom - h;
                float minTop = ChartPanel.Y + OverlayMargin;
                if (top < minTop) top = minTop;

                var cardRect = new DX.RectangleF(x, top, width, h);
                var rr = new D2D.RoundedRectangle { Rect = cardRect, RadiusX = 8, RadiusY = 8 };
                RenderTarget.FillRoundedRectangle(rr, cardBg);

                float tx = x + cardPadding;
                float ty = top + cardPadding;

                D2D.Brush badgeBg; D2D.Brush badgeTxt;
                GetBadgeBrushesFor(headlineState, out badgeBg, out badgeTxt);
                var badgeRect = new D2D.RoundedRectangle
                {
                    Rect = new DX.RectangleF(tx, ty, Math.Max(badgeLayout.Metrics.Width + cardPadding * 1.5f, 140), badgeH),
                    RadiusX = 6, RadiusY = 6
                };
                RenderTarget.FillRoundedRectangle(badgeRect, badgeBg);
                RenderTarget.DrawTextLayout(new DX.Vector2(tx + 6f, ty + 3f), badgeLayout, badgeTxt);
                ty += badgeRect.Rect.Height + lineGap + 2f;

                RenderTarget.DrawTextLayout(new DX.Vector2(tx, ty), shLayout, textBrush); ty += (float)Math.Ceiling(shLayout.Metrics.Height) + lineGap;
                RenderTarget.DrawTextLayout(new DX.Vector2(tx, ty), lgLayout, textBrush); ty += (float)Math.Ceiling(lgLayout.Metrics.Height) + lineGap;
                if (!string.IsNullOrEmpty(lineNet))     { RenderTarget.DrawTextLayout(new DX.Vector2(tx, ty), netLayout, textBrush); ty += (float)Math.Ceiling(netLayout.Metrics.Height) + lineGap; }
                if (!string.IsNullOrEmpty(lineSwing))   { RenderTarget.DrawTextLayout(new DX.Vector2(tx, ty), swLayout,  textBrush); ty += (float)Math.Ceiling(swLayout.Metrics.Height)  + lineGap; }

                if (!string.IsNullOrEmpty(lineSignal))
                {
                    D2D.Brush sigBrush = textBrush;
                    if (signal == "BUY")  sigBrush = okGreen;
                    if (signal == "SELL") sigBrush = badRed;
                    RenderTarget.DrawTextLayout(new DX.Vector2(tx, ty), sigLayout, sigBrush);
                    ty += (float)Math.Ceiling(sigLayout.Metrics.Height) + lineGap;
                }

                if (!string.IsNullOrEmpty(vixLine))
                    RenderTarget.DrawTextLayout(new DX.Vector2(tx, ty), vixLayout, textBrush);
            }
        }

        public override void OnRenderTargetChanged()
        {
            DisposeDx();
            base.OnRenderTargetChanged();
        }
        #endregion

        #region DX resources
        private void EnsureDxResources()
        {
            if (dwFactory == null)
                dwFactory = new DW.Factory();

            if (tfBadge == null) tfBadge = new DW.TextFormat(dwFactory, "Segoe UI Semibold", Math.Max(16f, BaseFontSize + 6));
            if (tfLine  == null) tfLine  = new DW.TextFormat(dwFactory, "Segoe UI", Math.Max(12f, BaseFontSize));
            if (tfSmall == null) tfSmall = new DW.TextFormat(dwFactory, "Segoe UI", Math.Max(10f, BaseFontSize - 2));

            if (textBrush == null)         textBrush         = new D2D.SolidColorBrush(RenderTarget, new DX.Color4(0.95f, 0.96f, 0.98f, 1f));
            if (badgeTextBrush == null)    badgeTextBrush    = new D2D.SolidColorBrush(RenderTarget, new DX.Color4(1f, 1f, 1f, 1f));
            if (badgeDarkTextBrush == null)badgeDarkTextBrush= new D2D.SolidColorBrush(RenderTarget, new DX.Color4(0.10f, 0.12f, 0.16f, 1f));

            if (badgeBgBuy == null)     badgeBgBuy     = new D2D.SolidColorBrush(RenderTarget, Dx(0x16,0xA3,0x4A));
            if (badgeBgSell == null)    badgeBgSell    = new D2D.SolidColorBrush(RenderTarget, Dx(0xDC,0x26,0x26));
            if (badgeBgCaution == null) badgeBgCaution = new D2D.SolidColorBrush(RenderTarget, Dx(0xF5,0x9E,0x0B));
            if (badgeBgChop == null)    badgeBgChop    = new D2D.SolidColorBrush(RenderTarget, Dx(0x9C,0xA3,0xAF));

            if (okGreen == null) okGreen = new D2D.SolidColorBrush(RenderTarget, Dx(0x22,0xC5,0x5E));
            if (warnAmber == null) warnAmber = new D2D.SolidColorBrush(RenderTarget, Dx(0xF5,0x9E,0x0B));
            if (badRed == null) badRed = new D2D.SolidColorBrush(RenderTarget, Dx(0xEF,0x44,0x44));

            if (cardBg == null) cardBg = new D2D.SolidColorBrush(RenderTarget, new DX.Color4(0.06f, 0.07f, 0.10f, 0.90f));
        }

        private void DisposeDx()
        {
            tfBadge?.Dispose(); tfBadge = null;
            tfLine?.Dispose();  tfLine  = null;
            tfSmall?.Dispose(); tfSmall = null;

            textBrush?.Dispose(); textBrush = null;
            badgeTextBrush?.Dispose(); badgeTextBrush = null;
            badgeDarkTextBrush?.Dispose(); badgeDarkTextBrush = null;

            badgeBgBuy?.Dispose(); badgeBgBuy = null;
            badgeBgSell?.Dispose(); badgeBgSell = null;
            badgeBgCaution?.Dispose(); badgeBgCaution = null;
            badgeBgChop?.Dispose(); badgeBgChop = null;

            okGreen?.Dispose(); okGreen = null;
            warnAmber?.Dispose(); warnAmber = null;
            badRed?.Dispose(); badRed = null;

            cardBg?.Dispose(); cardBg = null;

            dwFactory?.Dispose(); dwFactory = null;
        }

        private static DX.Color4 Dx(byte r, byte g, byte b, byte a = 255)
            => new DX.Color4(r / 255f, g / 255f, b / 255f, a / 255f);
        #endregion

        #region Badge helpers
        private void GetBadgeBrushesFor(string state, out D2D.Brush bg, out D2D.Brush text)
        {
            switch (state)
            {
                case "BUY":     bg = badgeBgBuy;     text = badgeTextBrush;     return;
                case "SELL":    bg = badgeBgSell;    text = badgeTextBrush;     return;
                case "CAUTION": bg = badgeBgCaution; text = badgeDarkTextBrush; return;
                case "CHOP":
                default:        bg = badgeBgChop;    text = badgeDarkTextBrush; return;
            }
        }
        #endregion
    }
