        #region Model math
        private void ComputeProbabilitiesModel(double swingScore)
        {
            double wSlope = WtSlope, wAtr = WtAtr, wSR = WtSR, wNet = WtNet, wPos = WtPos, wMom = WtMom, wSwing = WtSwing, wVol = WtVol;
            double wSum = Math.Max(1.0, wSlope + wAtr + wSR + wNet + wPos + wMom + wSwing + wVol);
            wSlope/=wSum; wAtr/=wSum; wSR/=wSum; wNet/=wSum; wPos/=wSum; wMom/=wSum; wSwing/=wSum; wVol/=wSum;

            double slopeFast = SafeDelta(emaFast, 1) / Math.Max(1e-12, emaFast[0]);
            double slopeSlow = SafeDelta(emaSlow, 1) / Math.Max(1e-12, emaSlow[0]);
            double nSlopeFast = Math.Tanh(slopeFast * 250.0);
            double nSlopeSlow = Math.Tanh(slopeSlow * 250.0);

            double atrExpFast = SafeDelta(atrFast, 1) / Math.Max(1e-12, atrFast[1]);
            double atrExpSlow = SafeDelta(atrSlow, 1) / Math.Max(1e-12, atrSlow[1]);
            double nAtrFast = Math.Tanh(Math.Abs(atrExpFast) * 10.0) * Math.Sign(nSlopeFast);
            double nAtrSlow = Math.Tanh(Math.Abs(atrExpSlow) * 10.0) * Math.Sign(nSlopeSlow);


            // ATR-based volatility regime for panel (derived from normalized ATR terms used in the model)
            lastAtrVolScore = Math.Max(0.0, Math.Min(1.0, 0.5 * (Math.Abs(nAtrFast) + Math.Abs(nAtrSlow))));
            atrVolRegime = (lastAtrVolScore < 0.33) ? "Calm"
                         : (lastAtrVolScore < 0.66) ? "Elevated"
                         : "Hot";

            double srRoom;
            if (nearestAboveTicks == int.MaxValue && nearestBelowTicks == int.MaxValue) srRoom = 0.0;
            else if (nearestAboveTicks == int.MaxValue) srRoom = 1.0;
            else if (nearestBelowTicks == int.MaxValue) srRoom = -1.0;
            else
            {
                double num = (double)nearestBelowTicks - (double)nearestAboveTicks;
                double den = (double)nearestBelowTicks + (double)nearestAboveTicks;
                srRoom = Math.Tanh((num / Math.Max(1.0, den)) * 2.0);
            }
            double nNet = Math.Tanh(netChangePct / 0.8);

            double pos = 0.0;
            if (atrSlow != null && atrSlow[0] > 0)
            {
                double z = (Close[0] - emaSlow[0]) / (2.0 * atrSlow[0]);
                pos = Math.Tanh(z);
            }

            double mom = 0.0;
            int n = Math.Max(1, MomLookback);
            if (CurrentBar >= n && atrFast != null && atrFast[0] > 0)
            {
                double dz = (Close[0] - Close[n]) / (2.0 * atrFast[0]);
                mom = Math.Tanh(dz);
            }

            // NEW: Relative volume participation (bounded, directional, continuation-friendly)
            // Idea: reward above-normal participation when price moves efficiently in the trend direction.
            // - relVol > 1 boosts confidence, relVol < 1 reduces it
            // - efficiency penalizes chop (big volume but little progress)
            // - sign aligns with trend direction (uses fast slope sign)
            double nVol = 0.0;
            if (volSma != null && volSma.IsValidDataPoint(0))
            {
                double avgVol = Math.Max(1.0, volSma[0]);
                double relVol = Volume[0] / avgVol; // ~1.0 is normal

                // Map relVol into a bounded range around 0
                // Using (relVol - 1) keeps normal volume near 0 contribution
                double relCentered = relVol - 1.0;

                // Directional efficiency: progress vs total range (0..1)
                double rng = Math.Max(TickSize, High[0] - Low[0]);
                double progress = Math.Abs(Close[0] - Open[0]);
                double eff = Math.Min(1.0, Math.Max(0.0, progress / rng));

                // Trend direction sign (fallback to candle direction if slope is flat)
                double dir = Math.Sign(nSlopeFast);
                if (dir == 0) dir = Math.Sign(Close[0] - Open[0]);

                // Scale and bound; eff dampens noisy volume
                // 1.6 chosen to make ~2x volume noticeable but not dominating
                nVol = Math.Tanh(relCentered * 1.6) * eff * dir;
            }

            double breakoutBias = 0.0;
            if (!double.IsNaN(priorDayLow)  && Close[0] < priorDayLow)  breakoutBias -= 0.20;
            if (!double.IsNaN(priorWeekLow) && Close[0] < priorWeekLow) breakoutBias -= 0.20;
            if (!double.IsNaN(priorDayHigh) && Close[0] > priorDayHigh)  breakoutBias += 0.20;
            if (!double.IsNaN(priorWeekHigh)&& Close[0] > priorWeekHigh)breakoutBias += 0.20;

            double nSwing = Math.Tanh(swingScore);

            double shortScore =
                (wSlope * 1.20) * nSlopeFast +
                (wAtr   * 1.00) * nAtrFast  +
                (wMom   * 1.20) * mom       +
                (wSR    * 1.00) * srRoom    +
(wNet   * 0.80) * nNet      +
                (wPos   * 0.50) * pos       +
                (wSwing * 1.00) * nSwing    +
                (wVol   * 1.00) * nVol      +
                breakoutBias;

            double longScore  =
                (wSlope * 1.00) * nSlopeSlow +
                (wAtr   * 1.00) * nAtrSlow   +
                (wMom   * 0.60) * mom        +
                (wSR    * 1.00) * srRoom     +
(wNet   * 0.60) * nNet       +
                (wPos   * 1.40) * pos        +
                (wSwing * 0.80) * nSwing     +
                (wVol   * 1.00) * nVol       +
                breakoutBias;

            shortProb = ToPercent(shortScore);
            longProb  = ToPercent(longScore);

            // SR proximity penalty (Option B) — bounded and applied after probabilities are built.
            ApplySRProximityPenalty(ref shortProb, ref longProb);

            shortState = ProbToState(shortProb);
            longState  = ProbToState(longProb);

            headlineProb  = (shortProb + longProb) / 2;
            headlineState = "CHOP";
            if (shortState == "BUY"  && longState == "BUY")   headlineState = "BUY";
            else if (shortState == "SELL" && longState == "SELL") headlineState = "SELL";
            else if (headlineProb >= 50 && headlineProb <= 59)    headlineState = "CAUTION";
        }

        private static int ToPercent(double score)
        {
            int p = (int)Math.Round(50.0 + 50.0 * Math.Tanh(score));
            if (p < 5) p = 5; if (p > 95) p = 95;
            return p;
        }
        
        private const double MaxSRProximityPenalty = 0.10; // 10% max penalty when at the level

        private static int ClampProb(int p)
        {
            if (p < 5) p = 5;
            if (p > 95) p = 95;
            return p;
        }

        // Option B: bounded probability penalty when price is within SRProximityTicks of the nearest tracked S/R level.
        // This is applied after the model builds probabilities so tuning remains comparable.
        private void ApplySRProximityPenalty(ref int shortP, ref int longP)
        {
            if (SRProximityTicks <= 0)
                return;

            int nearest = nearestSRTicks;
            if (nearest == int.MaxValue || nearest > SRProximityTicks)
                return;

            double ratio = (double)nearest / (double)SRProximityTicks; // 0..1
            if (ratio < 0.0) ratio = 0.0;
            if (ratio > 1.0) ratio = 1.0;

            double penalty = (1.0 - ratio) * MaxSRProximityPenalty; // 0..Max
            if (penalty <= 0.0)
                return;

            double mult = 1.0 - penalty;

            shortP = ClampProb((int)Math.Round(shortP * mult, MidpointRounding.AwayFromZero));
            longP  = ClampProb((int)Math.Round(longP  * mult, MidpointRounding.AwayFromZero));
        }

