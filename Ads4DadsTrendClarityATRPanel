        #region Market data — NetChange mirror of NT NetChangeDisplay
        protected override void OnMarketData(MarketDataEventArgs e)
        {
            if (e.IsReset) { mdLastPrice = double.NaN; return; }
            if (e.MarketDataType != MarketDataType.Last) return;

            if (e.Instrument?.MarketData?.LastClose != null)
                mdLastClose = e.Instrument.MarketData.LastClose.Price;

            mdLastPrice = e.Price;

            if (!double.IsNaN(mdLastClose) && mdLastClose > 0 && !double.IsNaN(mdLastPrice))
                netChangePct = 100.0 * ((mdLastPrice - mdLastClose) / mdLastClose);
        }
        #endregion

        #region OnBarUpdate — state/logic
        protected override void OnBarUpdate()
        {
            int need = Math.Max(Math.Max(FastEmaPeriod, SlowEmaPeriod), Math.Max(FastAtrPeriod, SlowAtrPeriod));
            need = Math.Max(need, Math.Max(5, VolLookback));
            if (CurrentBars[0] < need) { if (ShowEMA34) Values[0][0] = double.NaN; return; }

            if (BarsInProgress != 0) return;

            // Keep EMA(34) plot (toggle via ShowEMA34)
            if (ShowEMA34 && emaSlow != null && emaSlow.CurrentBar >= 0) Values[0][0] = emaSlow[0];
            else Values[0][0] = double.NaN;

            UpdateDayWeekExtremes();

            if (double.IsNaN(mdLastClose))
            {
                int firstTodayBarsAgo, priorCloseBarsAgo;
                GetSessionAnchors(out firstTodayBarsAgo, out priorCloseBarsAgo);
                if (firstTodayBarsAgo >= 0) sessionOpenPrice  = Open[firstTodayBarsAgo];
                if (priorCloseBarsAgo >= 0) priorSessionClose = Close[priorCloseBarsAgo];
                double anchor = (NetBasisMode == 0 ? priorSessionClose : sessionOpenPrice);
                if (anchor > 0)
                    netChangePct = 100.0 * ((Close[0] - anchor) / anchor);
            }

            UpdateNearestSR();

            double swingScore = ComputeSwingScore();
            ComputeProbabilitiesModel(swingScore);
            UpdateBadgeStreaks();
            ComputeSignal(); // NEW

            BuildDisplayStrings();
            MaybeLogCsv();
        }

        private void GetSessionAnchors(out int firstTodayBarsAgo, out int priorCloseBarsAgo)
        {
            firstTodayBarsAgo = -1;
            priorCloseBarsAgo = -1;
            if (CurrentBar < 0 || sess == null) return;

            DateTime today = sess.GetTradingDay(Time[0]);
            int barsAgo = 0;
            while (barsAgo <= CurrentBar && sess.GetTradingDay(Time[barsAgo]) == today)
                barsAgo++;

            int firstToday = barsAgo - 1;
            if (firstToday >= 0)
            {
                firstTodayBarsAgo = firstToday;
                if (firstToday + 1 <= CurrentBar)
                    priorCloseBarsAgo = firstToday + 1;
            }
        }

        private void UpdateDayWeekExtremes()
        {
            DateTime today = sess.GetTradingDay(Time[0]);
            if (double.IsNaN(currentDayHigh) || sess.GetTradingDay(Time[Math.Min(CurrentBar, 1)]) != today)
            {
                if (!double.IsNaN(currentDayHigh))
                {
                    priorDayHigh = currentDayHigh;
                    priorDayLow  = currentDayLow;
                }
                currentDayHigh = High[0];
                currentDayLow  = Low[0];
            }
            else
            {
                currentDayHigh = Math.Max(currentDayHigh, High[0]);
                currentDayLow  = Math.Min(currentDayLow,  Low[0]);
            }

            var cal = CultureInfo.InvariantCulture.Calendar;
            int curW = cal.GetWeekOfYear(today, CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday);
            DateTime prevBarDay = sess.GetTradingDay(Time[Math.Min(CurrentBar, 1)]);
            int prevW = cal.GetWeekOfYear(prevBarDay, CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday);
            if (double.IsNaN(weekHigh) || curW != prevW)
            {
                if (!double.IsNaN(weekHigh))
                {
                    priorWeekHigh = weekHigh;
                    priorWeekLow  = weekLow;
                }
                weekHigh = High[0];
                weekLow  = Low[0];
            }
            else
            {
                weekHigh = Math.Max(weekHigh, High[0]);
                weekLow  = Math.Min(weekLow,  Low[0]);
            }
        }
